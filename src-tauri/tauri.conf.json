{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "智询",
  "version": "0.1.0",
  "identifier": "com.chatquery.app",
  "build": {
    "beforeDevCommand": "npm --prefix /Users/hel04/Desktop/mycode/chatquery/frontend run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix /Users/hel04/Desktop/mycode/chatquery/frontend run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "智询",
        "width": 1200,
        "height": 800,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "active": true,
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "signingIdentity": null
    }
  }
}
