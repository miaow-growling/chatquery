{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "智询",
  "version": "0.1.0",
  "identifier": "com.chatquery.app",
  "build": {
    "beforeDevCommand": "node -e \"const fs=require('fs'),p=fs.existsSync('frontend')?'frontend':'../frontend';process.exit(require('child_process').spawnSync('npm',['--prefix',p,'run','dev'],{stdio:'inherit',shell:true}).status)\"",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node -e \"const fs=require('fs'),p=fs.existsSync('frontend')?'frontend':'../frontend';process.exit(require('child_process').spawnSync('npm',['--prefix',p,'run','build'],{stdio:'inherit',shell:true}).status)\"",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "智询",
        "width": 1200,
        "height": 800,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "active": true,
    "targets": "all",
    "resources": {
      "scripts/php_unserialize.py": "php_unserialize.py"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": [],
      "signingIdentity": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzRTAyMjEzMjM2OTkyNTQKUldSVWtta2pFeUxna3l0b0hlSThtelVUeWRwM0xtWGVjM01RbUw4cFFqaG5RVVl5bVZwNGdubmsK",
      "endpoints": [
        "https://chatquery.oss-cn-shenzhen.aliyuncs.com/chatquery/releases/latest.json"
      ]
    }
  }
}
