{
  "name": "chatquery-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npx --prefix frontend tauri dev",
    "build": "npx --prefix frontend tauri build",
    "build:mac:arm64": "npx --prefix frontend tauri build --target aarch64-apple-darwin",
    "build:mac:x64": "npx --prefix frontend tauri build --target x86_64-apple-darwin",
    "build:mac:universal": "npx --prefix frontend tauri build --target universal-apple-darwin",
    "build:mac:all": "npm run build:mac:arm64 && npm run build:mac:x64",
    "build:frontend": "npm --prefix frontend run build",
    "upload:oss": "node scripts/upload-oss.mjs",
    "release:oss": "node scripts/upload-oss.mjs --build",
    "release:mac:all": "node scripts/upload-oss.mjs --build --arch all",
    "bump": "node scripts/bump-version.mjs",
    "get-version": "node -p \"require('./src-tauri/tauri.conf.json').version\"",
    "deploy:website": "node website/inject-latest.mjs && python3 scripts/upload-ftp.py",
    "build:website-docker": "docker build -t chatquery-website ."
  }
}
