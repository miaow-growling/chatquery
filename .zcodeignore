# Node / frontend
/frontend/node_modules
/frontend/dist
/frontend/.vite

# OS / editor junk
.DS_Store
Thumbs.db
.idea
.vscode
.zcode
.workbuddy

# Local env & certificates (never commit secrets)
*.local
.env
.env.*
!.env.oss.example
!.env.ftp.example
!.env.example
.ossutilconfig*
*.pem
*.key
*.pfx
*.p12

# Tauri dev runtime log (regenerated on every run, may leak local paths)
.tauri-dev.log

