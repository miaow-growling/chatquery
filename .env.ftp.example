# =========================================================================
# 智询 (ChatQuery) 官网自动化 FTP 部署配置 (适配 1Panel)
# 复制本文件为 .env.ftp 并填写你的真实服务器凭据即可：
#   cp .env.ftp.example .env.ftp
# 注：.env.ftp 已加入 .gitignore，不会被提交到 Git，请放心保存密码。
# =========================================================================

# 1. 1Panel 服务器 IP 地址或解析域名
FTP_HOST=

# 2. FTP 端口（1Panel Pure-FTPd 默认是 21）
FTP_PORT=21

# 3. 1Panel 中为该网站创建的 FTP 用户名
FTP_USER=

# 4. 1Panel 中该 FTP 用户的连接密码
FTP_PASS=

# 5. 远程网站目标路径（如果 1Panel 创建 FTP 时绑定的目录已经是网站根目录，保持 / 即可）
FTP_REMOTE_DIR=/
