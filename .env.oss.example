# ============================================================
# 阿里云 OSS 发布上传配置文件模板
# 使用方法：复制一份为 .env.oss 并填写你的实际配置（.env.oss 已被 .gitignore 自动忽略，切勿提交！）
# ============================================================

# 1. 阿里云访问凭据（建议使用 RAM 用户 AccessKey，仅授予当前 Bucket 的 PutObject 等必要权限）
OSS_ACCESS_KEY_ID=LTAI5txxxxxxxxxxxxxxxx
OSS_ACCESS_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 2. 对象存储 Bucket 与地域配置
# Bucket 名称，例如：chatquery-releases
OSS_BUCKET=your-bucket-name

# 地域标识，例如：oss-cn-hangzhou、oss-cn-shanghai、oss-cn-beijing、oss-cn-shenzhen
# 系统会自动根据 REGION 拼接 endpoint: https://${OSS_REGION}.aliyuncs.com
OSS_REGION=oss-cn-hangzhou

# 可选：如果使用的是私有专线或独立 Endpoint，可显式指定（留空则默认基于 OSS_REGION）：
# OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# 3. 存储路径前缀（可自定义，默认值为 chatquery/releases）
# 实际对象保存路径为：${OSS_PREFIX}/v${VERSION}/${FILENAME}
OSS_PREFIX=chatquery/releases

# 4. 可选：绑定的 CDN 加速域名或自定义域名（如：https://download.chatquery.com）
# 若填写，latest.json 和控制台输出的下载链接将优先使用此域名；若留空则使用 OSS 官方公开访问地址
OSS_PUBLIC_DOMAIN=
